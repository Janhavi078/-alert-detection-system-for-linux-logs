# ML Service Environment Variables
# Copy this file to .env and update values

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Model Configuration
ML_MODEL=isolation-forest
ANOMALY_THRESHOLD=0.7
CONTAMINATION=0.1
N_ESTIMATORS=100
MAX_SAMPLES=256
RANDOM_STATE=42

# Database Configuration (for storing predictions)
# DATABASE_URL=postgresql://user:password@localhost/ml_db

# Logging
LOG_LEVEL=info

# Feature Engineering
ENABLE_TEXT_FEATURES=true
ENABLE_TEMPORAL_FEATURES=true
ENABLE_NETWORK_FEATURES=false

# Performance
BATCH_SIZE=100
CACHE_SIZE=1000
WORKERS=4

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=8001
